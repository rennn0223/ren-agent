[project]
name = "ren-agent"
version = "0.1.0"
description = "A LangGraph + Ollama demo agent with tool calling."
readme = "README.md"
requires-python = ">=3.12"
dependencies = [
    "langchain>=1.3.9",
    "langchain-core>=1.4.7",
    "langchain-ollama>=1.1.0",
    "langgraph>=1.2.5",
    "langgraph-cli[all,inmem]>=0.4.29",
    "langsmith>=0.8.16",
]
